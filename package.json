{
  "name": "polaris",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "yarn@1.22.15",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "echo \"Select a workspace, e.g. yarn workspace @polaris/api dev\"",
    "postinstall": "yarn workspace @polaris/db run generate",
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:migrate:dev": "yarn workspace @polaris/db run migrate:dev",
    "db:migrate:deploy": "yarn workspace @polaris/db run migrate:deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^20.14.15",
    "dotenv": "^16.4.5",
    "eslint": "^9.9.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vitest": "^2.0.5"
  }
}
