{
  "name": "@polaris/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./deps": {
      "types": "./dist/deps.d.ts",
      "default": "./dist/deps.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.1",
    "@polaris/ai": "*",
    "@polaris/db": "*",
    "@polaris/domain": "*",
    "@polaris/queue": "*",
    "@polaris/shared": "*",
    "@polaris/storage": "*",
    "fastify": "5.12.1"
  },
  "devDependencies": {
    "@polaris/analyzer": "*"
  }
}
