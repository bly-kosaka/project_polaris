{
  "name": "@polaris/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./analyzer-job-handler": {
      "types": "./dist/analyzer-job-handler.d.ts",
      "default": "./dist/analyzer-job-handler.js"
    },
    "./ai-explanation-job-handler": {
      "types": "./dist/ai-explanation-job-handler.d.ts",
      "default": "./dist/ai-explanation-job-handler.js"
    },
    "./deps": {
      "types": "./dist/deps.d.ts",
      "default": "./dist/deps.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@polaris/ai": "*",
    "@polaris/analyzer": "*",
    "@polaris/db": "*",
    "@polaris/domain": "*",
    "@polaris/queue": "*",
    "@polaris/shared": "*",
    "@polaris/storage": "*",
    "bullmq": "6.3.4"
  }
}
