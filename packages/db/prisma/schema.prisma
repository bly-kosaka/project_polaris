generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

// Deliberately not named AnalysisStatus — the domain type of that name
// (@polaris/domain) must never be confused with, or accidentally imported
// instead of, this Prisma-generated enum.
enum AnalysisLifecycleStatus {
  CREATED
  UPLOADED
  ANALYZING
  ANALYZER_RESULT_READY
  EXPLAINING
  COMPLETED
  FAILED
}

enum AnalyzerExecutionStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum AIExecutionStatus {
  NOT_REQUESTED
  QUEUED
  RUNNING
  SUCCESS
  FAILED
}

enum KnownInformationMatchType {
  EXACT
  PREFIX
}

// Single member today, but a real constraint — an unrestricted String
// column would let the mapper silently reinterpret any stored value as
// 'path' regardless of what's actually in the database.
enum KnownInformationTarget {
  PATH
}

// 'DELETED' = normal post-persist lifecycle delete (success or fatal
// Analyzer outcome); 'EXPIRED' = Cleanup/Retention safety-net delete. Same
// underlying storage delete, different terminal status recorded
// (35_Sprint_4_Plan_Review.md F-13).
enum UploadedAccessLogStatus {
  UPLOADED
  PROCESSING
  DELETED
  EXPIRED
}

enum RawLogDeletionStatus {
  PENDING
  SUCCESS
  FAILED
}

// AI_EXPLANATION is unused until the AI sprint — exists now so
// AnalysisExecution's @@unique([analysisId, type]) constraint doesn't need a
// schema change to accommodate it later.
enum AnalysisExecutionType {
  ANALYZER
  AI_EXPLANATION
}

enum AnalysisExecutionStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

// authSubject is the external-identity primary key (never email — accounts
// can change email, and a future second Auth Provider must not collide on
// it, 50_Development_Setup_and_Seventh_Sprint.md §25). Provider Credentials
// (password/session tokens) are never stored here — only the identity
// reference and a best-effort profile snapshot (Sprint 7 §4/§9). @unique on
// its own, not @@unique([authProvider, authSubject]), is correct while
// Clerk is the only Provider (Sprint 7's own scope) — see m-04 in
// 52_Sprint_7_Plan_Final_Review.md for the future-multi-provider caveat.
model Account {
  id            String   @id @default(cuid())
  authProvider  String
  authSubject   String   @unique
  email         String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects Project[]
}

model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  primaryUrl     String?
  hostname       String?
  status         ProjectStatus @default(ACTIVE)
  ownerAccountId String
  ownerAccount   Account       @relation(fields: [ownerAccountId], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  analyses            Analysis[]
  knownInformationSet ProjectKnownInformation[]

  @@index([ownerAccountId])
}

model Analysis {
  id             String                   @id @default(cuid())
  projectId      String
  project        Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  status         AnalysisLifecycleStatus  @default(CREATED)
  analyzerStatus AnalyzerExecutionStatus?
  aiStatus       AIExecutionStatus        @default(NOT_REQUESTED)

  originalFileName               String?
  fileSizeBytes                  Int?
  detectedLogFormat              String?
  firstSeen                      DateTime?
  lastSeen                       DateTime?
  totalLineCount                 Int?
  totalRequestCount              Int?
  observationSetVersion          String?
  analyzerConfigurationVersion   String?
  knownInformationDatasetVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  observationSet     ObservationSetRecord?
  uploadedAccessLog  UploadedAccessLog?
  executions         AnalysisExecution[]
  aiExplanation      AIExplanationRecord?

  @@index([projectId])
}

// analysisId @unique is the DB-level enforcement of "1 Analysis = 1
// ObservationSet" — a second insert for the same Analysis throws P2002.
model ObservationSetRecord {
  id            String   @id @default(cuid())
  analysisId    String   @unique
  analysis      Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  schemaVersion String
  data          Json
  createdAt     DateTime @default(now())
}

model ProjectKnownInformation {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  target      KnownInformationTarget    @default(PATH)
  matchType   KnownInformationMatchType
  pattern     String
  title       String
  description String?
  enabled     Boolean                   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, enabled])
}

// analysisId @unique is the DB-level enforcement of "1 Analysis = max 1 Raw
// Access Log" (34_Development_Setup_and_Fourth_Sprint.md §14).
model UploadedAccessLog {
  id               String   @id @default(cuid())
  analysisId       String   @unique
  analysis         Analysis @relation(fields: [analysisId], references: [id], onDelete: Restrict)

  originalFileName String
  sizeBytes        Int
  mimeType         String?
  storageKey       String

  status         UploadedAccessLogStatus @default(UPLOADED)
  deletionStatus RawLogDeletionStatus    @default(PENDING)

  createdAt DateTime  @default(now())
  expiresAt DateTime
  deletedAt DateTime?
}

// @@unique([analysisId, type]) is the DB-level enforcement of "1 Analysis x
// 1 Execution Type = 1 mutable Execution Record" (35_Sprint_4_Plan_Review.md
// F-05) — findByAnalysisIdAndType() relies on this being at most one row.
model AnalysisExecution {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  type   AnalysisExecutionType
  status AnalysisExecutionStatus

  attempt     Int       @default(0)
  errorCode   String?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([analysisId, type])
}

// analysisId @unique is the DB-level enforcement of "1 Analysis = max 1
// AIExplanationRecord" (44_Development_Setup_and_Sixth_Sprint.md §45/§90) —
// a second insert for the same Analysis throws P2002, same pattern as
// ObservationSetRecord. Raw Prompt / Raw AI Response / Reasoning are never
// stored here (§44).
model AIExplanationRecord {
  id         String   @id @default(cuid())
  analysisId String   @unique
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  schemaVersion String
  promptVersion String
  provider      String
  model         String

  data Json

  providerResponseId String?
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
